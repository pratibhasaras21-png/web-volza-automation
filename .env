# Gmail IMAP credentials
# Volza login email
VOLZA_LOGIN_EMAIL=pratibha.saras@volza.com

# Microsoft Graph API credentials (for reading OTP from Outlook)
# Real values live in .env.local (gitignored) - AZURE_TENANT_ID, AZURE_CLIENT_ID, AZURE_CLIENT_SECRET
OUTLOOK_USER=pratibha.saras@volza.com

# Company to select on the company selection page (leave blank to select first)
VOLZA_COMPANY=SME Biyearly Testing

# OTP email filter settings
OTP_SENDER_DOMAIN=volza.com
OTP_SUBJECT_KEYWORD=OTP
OTP_WAIT_MS=60000
OTP_POLL_INTERVAL_MS=5000

# Universal Search keywords (change these to match your data)
SEARCH_HS2=44
SEARCH_HS4=4401
SEARCH_HS6=440811
SEARCH_HS8=44081100
SEARCH_COMPANY=Tata MOTRORS
SEARCH_CONSIGNEE= Reliance
SEARCH_SHIPPER= Honda 
