  // ── TC-43: Auto-Update state after refresh ──────────────────────────────────
  test('TC-43: Auto-Update state persists after refresh', async ({ page }) => {
    console.log('[TC-43] Navigate to My Workspaces');
    await page.locator('a:has-text("My Workspaces")').first().click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 });
    await page.waitForTimeout(1500);

    const wsCard = page.locator('.workspace-card, .saved-query-box').first();
    await wsCard.waitFor({ state: 'visible', timeout: 15000 });
    const wsName = await wsCard.locator('a.desc-text').first().getAttribute('title');
    const toggle = wsCard.locator('[class*="auto-update"] input[type="checkbox"], [class*="toggle"] input, [class*="toggle"]').first();

    if (await toggle.isVisible({ timeout: 5000 }).catch(() => false)) {
      const initialState = await toggle.isChecked().catch(() => false);
      await toggle.click();
      await page.waitForTimeout(2000);
      const toggledState = await toggle.isChecked().catch(() => !initialState);
      console.log(`[TC-43] Toggled Auto-Update for "${wsName}": ${initialState} -> ${toggledState}`);

      await page.reload();
      await page.waitForLoadState('domcontentloaded', { timeout: 15000 }).catch(() => {});
      await page.waitForTimeout(1500);

      const cardAfterReload = page.locator('.workspace-card, .saved-query-box').filter({ hasText: wsName }).first();
      const toggleAfterReload = cardAfterReload.locator('[class*="auto-update"] input[type="checkbox"], [class*="toggle"] input, [class*="toggle"]').first();
      const stateAfterReload = await toggleAfterReload.isChecked().catch(() => null);
      expect.soft(stateAfterReload).toBe(toggledState);
      console.log(`[TC-43] ✅ Auto-Update state (${toggledState}) persisted after refresh`);
    } else {
      console.log('[TC-43] Auto-Update control not found — skipping');
    }
  });

  // ── TC-44: Auto-Update with no new data ─────────────────────────────────────
  test('TC-44: Auto-Update with no new data does not error or duplicate', async ({ page }) => {
    console.log('[TC-44] Navigate to My Workspaces and enable Auto-Update on a workspace');
    await page.locator('a:has-text("My Workspaces")').first().click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 });
    await page.waitForTimeout(1500);

    const pageErrors = [];
    page.on('pageerror', (err) => pageErrors.push(err.message));

    const wsCard = page.locator('.workspace-card, .saved-query-box').first();
    await wsCard.waitFor({ state: 'visible', timeout: 15000 });
    const wsName = await wsCard.locator('a.desc-text').first().getAttribute('title');
    const toggle = wsCard.locator('[class*="auto-update"] input[type="checkbox"], [class*="toggle"] input, [class*="toggle"]').first();

    if (await toggle.isVisible({ timeout: 5000 }).catch(() => false)) {
      const wasChecked = await toggle.isChecked().catch(() => false);
      if (!wasChecked) await toggle.click();
      console.log(`[TC-44] Auto-Update enabled on "${wsName}", waiting for a refresh cycle`);
      await page.waitForTimeout(5000);

      const crashState = page.locator('[class*="error-boundary"], [class*="crash"]').first();
      const crashed = await crashState.isVisible({ timeout: 2000 }).catch(() => false);
      const countAfter = await page.locator('.workspace-card, .saved-query-box').filter({ hasText: wsName }).count();

      expect.soft(crashed).toBeFalsy();
      expect.soft(pageErrors, `No unhandled JS errors expected: ${pageErrors.join('; ')}`).toHaveLength(0);
      expect.soft(countAfter, 'Auto-Update with no new data should not duplicate the workspace card').toBe(1);
      console.log('[TC-44] ✅ No crash, no unhandled errors, and no duplicate workspace after an Auto-Update cycle with no new data');
    } else {
      console.log('[TC-44] Auto-Update control not found — skipping');
    }
  });

