    const deleteOption = dropdown.locator('.df-panel-tools').filter({ hasText: /delete/i }).first();
    await deleteOption.click();
    await page.waitForTimeout(800);
    const confirmDialog = page.locator('.swal-overlay:visible').filter({ hasText: /delete workspace/i }).first();
    await expect.soft(confirmDialog).toBeVisible({ timeout: 8000 });

    console.log('[TC-49] Simulate network interruption right as deletion is confirmed');
