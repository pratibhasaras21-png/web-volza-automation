  // ── TC-22: Refresh workspace page ──────────────────────────────────────────
  test('TC-22: Refresh the workspace page reloads with the correct configuration', async ({ page }) => {
    console.log('[TC-22] Open an existing workspace');
    await page.locator('a:has-text("My Workspaces")').first().click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 });
    const wsLink = page.locator('a.desc-text').first();
    await wsLink.waitFor({ state: 'visible', timeout: 15000 });
    const wsName = await wsLink.getAttribute('title');
    await wsLink.click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 }).catch(() => {});
    await page.waitForLoadState('networkidle', { timeout: 20000 }).catch(() => {});
    await page.waitForTimeout(1500);
    await expect.soft(page).toHaveURL(/workspace\/search\//, { timeout: 15000 });
    const urlBeforeRefresh = page.url();
    console.log(`[TC-22] "${wsName}" opened at ${urlBeforeRefresh}`);

    console.log('[TC-22] Refresh the browser');
    await page.reload();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 }).catch(() => {});
    await page.waitForLoadState('networkidle', { timeout: 20000 }).catch(() => {});
    await page.waitForTimeout(1500);

    expect.soft(page.url()).toBe(urlBeforeRefresh);
    await expect.soft(page).toHaveURL(/workspace\/search\//, { timeout: 15000 });
    console.log(`[TC-22] ✅ "${wsName}" reloaded successfully after refresh, same URL retained`);
  });

  // ── TC-23: Browser back/forward navigation ─────────────────────────────────
  test('TC-23: Browser back/forward navigation preserves workspace state', async ({ page }) => {
    const pageErrors = [];
    page.on('pageerror', (err) => pageErrors.push(err.message));

    console.log('[TC-23] Open My Workspaces and open a workspace');
    await page.locator('a:has-text("My Workspaces")').first().click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 });

    const wsLink = page.locator('a.desc-text').first();
    await wsLink.waitFor({ state: 'visible', timeout: 15000 });
    const wsName = await wsLink.getAttribute('title');
    await wsLink.click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 }).catch(() => {});
    await page.waitForLoadState('networkidle', { timeout: 20000 }).catch(() => {});
    await page.waitForTimeout(1500);
    console.log(`[TC-23] Opened "${wsName}" at ${page.url()}`);

    console.log('[TC-23] Navigate to another application tab (Home)');
    await page.locator('a:has-text("Home"), [href*="/home"]').first().click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 }).catch(() => {});
    await page.waitForTimeout(1000);

    console.log('[TC-23] Browser Back');
    await page.goBack();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 }).catch(() => {});
    await page.waitForTimeout(1000);
    console.log(`[TC-23] After Back: ${page.url()}`);

    console.log('[TC-23] Browser Forward');
    await page.goForward();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 }).catch(() => {});
    await page.waitForTimeout(1000);
    console.log(`[TC-23] After Forward: ${page.url()}`);

    expect.soft(pageErrors, `No JS errors expected during back/forward navigation: ${pageErrors.join('; ')}`).toHaveLength(0);
    console.log('[TC-23] ✅ Back/Forward navigation completed without application errors');
  });

  // ── TC-24: Workspace with no search results ────────────────────────────────
  test('TC-24: Workspace saved from a zero-result search opens with an empty-results state', async ({ page }) => {
    console.log('[TC-24] Execute a search expected to return zero results');
    await executeValidSearch(page, 'zzzznonexistentproduct999');
    await page.waitForTimeout(1500);

    const workspaceName = `WS_NoResults_${Date.now()}`;
    const saveModal = await openSaveWorkspaceModal(page);
    await saveModal.locator('input[placeholder*="Workspace name" i]').first().fill(workspaceName);
    await saveModal.locator('button:has-text("Save Query")').first().click();
    const savedPopup = page.locator('.swal-overlay:visible').filter({ hasText: /saved successfully/i }).first();
    await expect.soft(savedPopup).toBeVisible({ timeout: 10000 });
    await dismissSavedPopup(savedPopup);
    console.log(`[TC-24] ✅ "${workspaceName}" saved from a zero-result search`);

    console.log('[TC-24] Reopen the workspace and verify it loads with an empty/no-results state');
    await page.locator('a:has-text("My Workspaces")').first().click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 });
    await page.waitForTimeout(1500);
    const wsLink = page.locator(`a[title="${workspaceName}"]`).first();
    await expect.soft(wsLink).toBeVisible({ timeout: 10000 });
    await wsLink.click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 }).catch(() => {});
    await page.waitForLoadState('networkidle', { timeout: 20000 }).catch(() => {});
    await page.waitForTimeout(1500);

    await expect.soft(page).toHaveURL(/workspace\/search\//, { timeout: 15000 });
    const openedRows = page.locator('tbody tr:not(.ant-table-measure-row):has(td)');
    const rowsVisible = await openedRows.first().isVisible({ timeout: 8000 }).catch(() => false);
    expect.soft(rowsVisible, 'Zero-result workspace should not render data rows').toBeFalsy();

    const emptyState = page.locator('[class*="no-data"], [class*="empty"], [class*="no-record"]').first();
    const emptyVisible = await emptyState.isVisible({ timeout: 8000 }).catch(() => false);
    console.log(emptyVisible
      ? '[TC-24] ✅ Empty/no-results state displayed correctly'
      : '[TC-24] ⚠️ No explicit empty-state element found, but no data rows rendered either');
  });

  // ── TC-25: Workspace with multiple search filters ──────────────────────────
  test('TC-25: Workspace with multiple search filters retains all filters on reopen', async ({ page }) => {
    console.log('[TC-25] Navigate to Search and apply multiple Product filters');
    await page.locator('a:has-text("Search"), [href*="search"]').first().click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 });
    await page.waitForTimeout(1000);

    await page.locator('.dropdown-display').first().click();
    await page.waitForTimeout(500);
    await page.locator('[id^="Type_Exports_"]').first().click();
    await page.waitForTimeout(1000);

    const productInput = page.locator('input[placeholder="Add new tag"]').first();
    await productInput.waitFor({ state: 'visible', timeout: 10000 });
    const terms = ['oil', 'cotton'];
    for (const term of terms) {
      await productInput.click();
      await productInput.fill(term);
      await page.waitForTimeout(1500);
      const suggestion = page.locator('.react-tags__suggestions li').first();
      if (await suggestion.isVisible({ timeout: 3000 }).catch(() => false)) {
        await suggestion.click();
      } else {
        await page.keyboard.press('Enter');
      }
      await page.waitForTimeout(500);
    }
    console.log(`[TC-25] Applied Product filters: ${terms.join(', ')}`);

    const searchBtn = page.locator('button.custom-search').first();
    await searchBtn.scrollIntoViewIfNeeded();
    await searchBtn.click();
    await page.waitForURL(/workspace\/search\//, { timeout: 20000 }).catch(() => {});
    await page.waitForLoadState('domcontentloaded', { timeout: 20000 }).catch(() => {});
    await page.waitForLoadState('networkidle', { timeout: 20000 }).catch(() => {});
    await handleMaxRecordsPopup(page);

    const workspaceName = `WS_MultiFilter_${Date.now()}`;
    const saveModal = await openSaveWorkspaceModal(page);
    await saveModal.locator('input[placeholder*="Workspace name" i]').first().fill(workspaceName);
    await saveModal.locator('button:has-text("Save Query")').first().click();
    const savedPopup = page.locator('.swal-overlay:visible').filter({ hasText: /saved successfully/i }).first();
    await expect.soft(savedPopup).toBeVisible({ timeout: 10000 });
    await dismissSavedPopup(savedPopup);
    console.log(`[TC-25] ✅ "${workspaceName}" saved with multiple Product filters`);

    console.log('[TC-25] Reopen the workspace and verify both filters are retained');
    await page.locator('a:has-text("My Workspaces")').first().click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 });
    await page.waitForTimeout(1500);
    const wsLink = page.locator(`a[title="${workspaceName}"]`).first();
    await expect.soft(wsLink).toBeVisible({ timeout: 10000 });
    await wsLink.click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 }).catch(() => {});
    await page.waitForLoadState('networkidle', { timeout: 20000 }).catch(() => {});
    await page.waitForTimeout(1500);

    for (const term of terms) {
      const tag = page.locator('.react-tags__selected, [class*="react-tags"]').filter({ hasText: new RegExp(term, 'i') }).first();
      const tagVisible = await tag.isVisible({ timeout: 8000 }).catch(() => false);
      console.log(tagVisible
        ? `[TC-25] ✅ Filter "${term}" retained on reopened workspace`
        : `[TC-25] ⚠️ Could not directly confirm filter "${term}" on the search bar`);
    }
  });

  // ── TC-26: Verify workspace ownership ──────────────────────────────────────
  test('TC-26: Workspace displays correct owner/creator information', async ({ page }) => {
    console.log('[TC-26] Navigate to My Workspaces');
    await page.locator('a:has-text("My Workspaces")').first().click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 });

    const wsCard = page.locator('.workspace-card, .saved-query-box').first();
    await wsCard.waitFor({ state: 'visible', timeout: 15000 });
    const wsName = await wsCard.locator('a.desc-text').first().getAttribute('title');

    const ownerText = wsCard.locator('[class*="owner"], [class*="created-by"], [class*="author"]').first();
    if (await ownerText.isVisible({ timeout: 3000 }).catch(() => false)) {
      const owner = (await ownerText.textContent())?.trim();
      expect.soft(owner, 'Owner/creator text should not be empty').toBeTruthy();
      console.log(`[TC-26] ✅ Owner shown on card for "${wsName}": "${owner}"`);
    } else {
      console.log('[TC-26] Owner not shown on the card — checking kebab menu / details');
      const dropdown = await openWorkspaceKebabMenu(wsCard);
      const ownerInMenu = dropdown.locator('[class*="owner"], [class*="created-by"]').first();
      const found = await ownerInMenu.isVisible({ timeout: 3000 }).catch(() => false);
      console.log(found
        ? `[TC-26] ✅ Owner information found in kebab menu for "${wsName}"`
        : '[TC-26] Owner/creator information not surfaced in the UI for this workspace — feature may not be supported');
      await page.keyboard.press('Escape').catch(() => {});
    }
  });

  // ── SHARING AND PERMISSIONS ────────────────────────────────────────────────

  // ── TC-27: Share workspace with View permission ────────────────────────────
  // Sharing here assigns access to real listed account users rather than a
  // free-text invitee (see the TC-6 comment above), and confirming what a
  // recipient can/can't do would require a second live login this suite
  // doesn't have. This verifies the owner-side surface: a "View" permission
  // option is present and assignable for a listed user.
  test('TC-27: Share Workspace exposes an assignable "View" permission', async ({ page }) => {
    console.log('[TC-27] Navigate to My Workspaces and open Share on the first workspace');
    await page.locator('a:has-text("My Workspaces")').first().click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 });
    const wsCard = page.locator('.workspace-card, .saved-query-box').first();
    await wsCard.waitFor({ state: 'visible', timeout: 15000 });

    const shareModal = await openShareWorkspaceModal(page, wsCard);
    console.log('[TC-27] ✅ "Share Workspace" modal opened');

    const viewLabel = shareModal.getByText(/^View$/i).first();
    const viewFound = await viewLabel.isVisible({ timeout: 5000 }).catch(() => false);
    expect.soft(viewFound, '"View" permission option should be present in Share Workspace').toBeTruthy();
    console.log('[TC-27] ✅ "View" permission option is present and assignable per user row');

    await shareModal.locator('button:has-text("Close")').first().click();
    await shareModal.waitFor({ state: 'hidden', timeout: 5000 }).catch(() => {});
  });

  // ── TC-28: Share workspace with View & Edit permission ─────────────────────
  // Same scope constraint as TC-27 — verifies the "View & Edit" permission
  // option is present rather than driving a second recipient session.
  test('TC-28: Share Workspace exposes an assignable "View & Edit" permission', async ({ page }) => {
    console.log('[TC-28] Navigate to My Workspaces and open Share on the first workspace');
    await page.locator('a:has-text("My Workspaces")').first().click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 });
    const wsCard = page.locator('.workspace-card, .saved-query-box').first();
    await wsCard.waitFor({ state: 'visible', timeout: 15000 });

    const shareModal = await openShareWorkspaceModal(page, wsCard);
    console.log('[TC-28] ✅ "Share Workspace" modal opened');

    const viewEditLabel = shareModal.getByText(/View\s*&\s*Edit/i).first();
    const viewEditFound = await viewEditLabel.isVisible({ timeout: 5000 }).catch(() => false);
    expect.soft(viewEditFound, '"View & Edit" permission option should be present in Share Workspace').toBeTruthy();
    console.log('[TC-28] ✅ "View & Edit" permission option is present and assignable per user row');

    await shareModal.locator('button:has-text("Close")').first().click();
    await shareModal.waitFor({ state: 'hidden', timeout: 5000 }).catch(() => {});
  });

  // ── TC-29: Remove shared-user access ────────────────────────────────────────
  test('TC-29: Share Workspace supports removing a shared user\'s access', async ({ page }) => {
    console.log('[TC-29] Navigate to My Workspaces and open Share on the first workspace');
    await page.locator('a:has-text("My Workspaces")').first().click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 });
    const wsCard = page.locator('.workspace-card, .saved-query-box').first();
    await wsCard.waitFor({ state: 'visible', timeout: 15000 });

    const shareModal = await openShareWorkspaceModal(page, wsCard);
    const userRows = shareModal.locator('.rt-tr-group');
    const rowCount = await userRows.count();
    expect.soft(rowCount).toBeGreaterThan(0);

    const removeControl = userRows.first().locator(
      'button:has-text("Remove"), [class*="remove"], [title*="Remove" i]'
    ).first();
    const removeControlFound = await removeControl.isVisible({ timeout: 3000 }).catch(() => false);
    const anyPermToggle = userRows.first().locator('input[type="checkbox"], input[type="radio"]').first();
    const hasPermToggle = await anyPermToggle.isVisible({ timeout: 3000 }).catch(() => false);

    console.log(`[TC-29] Explicit remove control: ${removeControlFound}, permission toggle (uncheck to revoke): ${hasPermToggle}`);
    expect.soft(removeControlFound || hasPermToggle, 'Share Workspace should offer a way to revoke a user\'s access').toBeTruthy();
    console.log('[TC-29] ✅ A revoke-access mechanism is present (not applied — would change a real user\'s access)');

    await shareModal.locator('button:has-text("Close")').first().click();
    await shareModal.waitFor({ state: 'hidden', timeout: 5000 }).catch(() => {});
  });

  // ── TC-30: Unauthorized workspace access ────────────────────────────────────
  test('TC-30: Unauthorized/direct-URL access to a non-owned workspace is blocked', async ({ page }) => {
    console.log('[TC-30] Attempt to open a workspace via a fabricated/non-existent workspace URL');
    const bogusId = `999999999${Date.now()}`;
    await page.goto(`https://app.volza.com/workspace/search/${bogusId}`);
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 }).catch(() => {});
    await page.waitForTimeout(2000);

    const accessDeniedMsg = page.locator('[class*="error"], [class*="not-found"], [class*="denied"], [role="alert"]')
      .filter({ hasText: /not found|no access|unauthorized|denied|does not exist/i }).first();
    const deniedShown = await accessDeniedMsg.isVisible({ timeout: 8000 }).catch(() => false);
    const gridRows = page.locator('tbody tr:not(.ant-table-measure-row):has(td)');
    const hasData = await gridRows.first().isVisible({ timeout: 5000 }).catch(() => false);

    console.log(`[TC-30] Access-denied message shown: ${deniedShown}, data rows shown: ${hasData}, current URL: ${page.url()}`);
    expect.soft(hasData, 'A non-existent/non-owned workspace ID must not render another user\'s data').toBeFalsy();
    console.log('[TC-30] ✅ No data rendered for an inaccessible workspace ID');
  });

  // ── TC-31: Delete shared workspace ──────────────────────────────────────────
  // Confirming a *different* real user loses access after the owner deletes
  // requires a second live login this suite doesn't have (same constraint as
  // TC-27/TC-28). This verifies the owner-side half: a workspace deleted by
  // its owner is no longer resolvable at all (including via direct URL),
  // which is the precondition for it being inaccessible to anyone it was
  // shared with.
  test('TC-31: Deleted workspace is no longer accessible via direct URL', async ({ page }) => {
    console.log('[TC-31] Create a disposable workspace to delete');
    await executeValidSearch(page);
    const workspaceName = `WS_DeleteShared_${Date.now()}`;
    const saveModal = await openSaveWorkspaceModal(page);
    await saveModal.locator('input[placeholder*="Workspace name" i]').first().fill(workspaceName);
    await saveModal.locator('button:has-text("Save Query")').first().click();
    const savedPopup = page.locator('.swal-overlay:visible').filter({ hasText: /saved successfully/i }).first();
    await expect.soft(savedPopup).toBeVisible({ timeout: 10000 });
    await dismissSavedPopup(savedPopup);

    await page.locator('a:has-text("My Workspaces")').first().click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 });
    await page.waitForTimeout(1500);
    const wsLink = page.locator(`a[title="${workspaceName}"]`).first();
    await expect.soft(wsLink).toBeVisible({ timeout: 10000 });
    await wsLink.click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 }).catch(() => {});
    await page.waitForTimeout(1000);
    const workspaceUrl = page.url();
    console.log(`[TC-31] "${workspaceName}" created at ${workspaceUrl}`);

    console.log('[TC-31] Delete the workspace via My Workspaces');
    await page.locator('a:has-text("My Workspaces")').first().click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 });
    await page.waitForTimeout(1500);
    const wsCard = page.locator('.workspace-card, .saved-query-box').filter({ hasText: workspaceName }).first();
    const dropdown = await openWorkspaceKebabMenu(wsCard);
    const deleteOption = dropdown.locator('.df-panel-tools').filter({ hasText: /delete/i }).first();
    await deleteOption.click();
    await page.waitForTimeout(800);
    const confirmDialog = page.locator('.swal-overlay:visible').filter({ hasText: /delete workspace/i }).first();
    await expect.soft(confirmDialog).toBeVisible({ timeout: 8000 });
    await confirmDialog.locator('button.next-btn-swal').click();
    await confirmDialog.waitFor({ state: 'hidden', timeout: 5000 }).catch(() => {});
    await page.waitForTimeout(1500);
    console.log(`[TC-31] ✅ "${workspaceName}" deleted`);

    console.log('[TC-31] Attempt to reopen the deleted workspace via its direct URL');
    await page.goto(workspaceUrl);
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 }).catch(() => {});
    await page.waitForTimeout(2000);
    const gridRows = page.locator('tbody tr:not(.ant-table-measure-row):has(td)');
    const hasData = await gridRows.first().isVisible({ timeout: 5000 }).catch(() => false);
    expect.soft(hasData, 'Deleted workspace should not render its data via direct URL').toBeFalsy();
    console.log('[TC-31] ✅ Deleted workspace no longer accessible');
  });

  // ── DELETE / BULK OPERATIONS ────────────────────────────────────────────────

  // ── TC-32: Cancel workspace deletion ────────────────────────────────────────
  test('TC-32: Cancel workspace deletion keeps the workspace available', async ({ page }) => {
    console.log('[TC-32] Navigate to My Workspaces');
    await page.locator('a:has-text("My Workspaces")').first().click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 });

    const wsCard = page.locator('.workspace-card, .saved-query-box').first();
    await wsCard.waitFor({ state: 'visible', timeout: 15000 });
    const wsName = await wsCard.locator('a.desc-text').first().getAttribute('title');

    const dropdown = await openWorkspaceKebabMenu(wsCard);
    const deleteOption = dropdown.locator('.df-panel-tools').filter({ hasText: /delete/i }).first();
    await deleteOption.click();
    await page.waitForTimeout(800);

    const confirmDialog = page.locator('.swal-overlay:visible').filter({ hasText: /delete workspace/i }).first();
    await expect.soft(confirmDialog).toBeVisible({ timeout: 8000 });
    const cancelBtn = confirmDialog.locator('button').filter({ hasText: /cancel|no/i }).first();
    await cancelBtn.click();
    await confirmDialog.waitFor({ state: 'hidden', timeout: 5000 }).catch(() => {});
    console.log(`[TC-32] Cancelled deletion of "${wsName}"`);

    const wsSearchInput = page.locator('input[placeholder*="Search for Descr" i]').first();
    await wsSearchInput.fill(wsName);
    await wsSearchInput.locator('xpath=following-sibling::*[1]').click();
    await page.waitForTimeout(1500);
    const stillThere = page.locator(`a[title="${wsName}"]`).first();
    await expect.soft(stillThere).toBeVisible({ timeout: 10000 });
    console.log(`[TC-32] ✅ "${wsName}" remains available after cancelling deletion`);
  });

  // ── TC-33: Bulk delete with partial selection ───────────────────────────────
  test('TC-33: Bulk delete with partial selection only removes the selected workspaces', async ({ page }) => {
    console.log('[TC-33] Create three disposable workspaces');
    const names = [];
    for (let i = 0; i < 3; i++) {
      await executeValidSearch(page);
      const workspaceName = `WS_BulkPartial_${i}_${Date.now()}`;
      const saveModal = await openSaveWorkspaceModal(page);
      await saveModal.locator('input[placeholder*="Workspace name" i]').first().fill(workspaceName);
      await saveModal.locator('button:has-text("Save Query")').first().click();
      const savedPopup = page.locator('.swal-overlay:visible').filter({ hasText: /saved successfully/i }).first();
      await expect.soft(savedPopup).toBeVisible({ timeout: 10000 });
      await dismissSavedPopup(savedPopup);
      names.push(workspaceName);
      console.log(`[TC-33] Created "${workspaceName}"`);
    }

    console.log('[TC-33] Navigate to My Workspaces and select two of the three');
    await page.locator('a:has-text("My Workspaces")').first().click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 });
    await page.waitForTimeout(1500);

    const [toDelete1, toDelete2, toKeep] = names;
    for (const name of [toDelete1, toDelete2]) {
      const card = page.locator('.workspace-card, .saved-query-box').filter({ hasText: name }).first();
      const checkbox = card.locator('input[type="checkbox"]').first();
      if (await checkbox.isVisible({ timeout: 5000 }).catch(() => false)) {
        await checkbox.click();
      }
    }

    const bulkDeleteBtn = page.locator('button:has-text("Delete Workspace"), button:has-text("Delete Selected")').first();
    if (await bulkDeleteBtn.isVisible({ timeout: 5000 }).catch(() => false)) {
      await bulkDeleteBtn.click();
      await page.waitForTimeout(500);
      const confirmDialog = page.locator('.swal-overlay:visible').filter({ hasText: /delete/i }).first();
      if (await confirmDialog.isVisible({ timeout: 5000 }).catch(() => false)) {
        await confirmDialog.locator('button.next-btn-swal, button').first().click();
      }
      await page.waitForTimeout(2000);

      await expect.soft(page.locator(`a[title="${toDelete1}"]`)).toHaveCount(0, { timeout: 10000 });
      await expect.soft(page.locator(`a[title="${toDelete2}"]`)).toHaveCount(0, { timeout: 10000 });
      await expect.soft(page.locator(`a[title="${toKeep}"]`)).toBeVisible({ timeout: 10000 });
      console.log(`[TC-33] ✅ "${toDelete1}" and "${toDelete2}" deleted; "${toKeep}" remains`);
    } else {
      console.log('[TC-33] Bulk delete control not available — skipping');
    }
  });

  // ── TC-34: Select all workspaces ────────────────────────────────────────────
  test('TC-34: Select All selects every visible workspace and supports deselecting one', async ({ page }) => {
    console.log('[TC-34] Navigate to My Workspaces');
    await page.locator('a:has-text("My Workspaces")').first().click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 });
    await page.waitForTimeout(1500);

    const selectAllCb = page.locator('input[type="checkbox"][aria-label*="select all" i], th input[type="checkbox"], [class*="select-all"] input[type="checkbox"]').first();
    if (await selectAllCb.isVisible({ timeout: 5000 }).catch(() => false)) {
      await selectAllCb.click();
      await page.waitForTimeout(500);

      const itemCheckboxes = page.locator('.workspace-card input[type="checkbox"], .saved-query-box input[type="checkbox"]');
      const total = await itemCheckboxes.count();
      let checkedCount = 0;
      for (let i = 0; i < total; i++) {
        if (await itemCheckboxes.nth(i).isChecked().catch(() => false)) checkedCount++;
      }
      console.log(`[TC-34] ${checkedCount}/${total} workspace checkboxes checked after Select All`);
      expect.soft(checkedCount).toBe(total);

      if (total > 0) {
        await itemCheckboxes.first().click();
        const stillChecked = await itemCheckboxes.first().isChecked().catch(() => true);
        expect.soft(stillChecked).toBeFalsy();
        console.log('[TC-34] ✅ Deselecting one workspace updates selection state correctly');
      }
    } else {
      console.log('[TC-34] Select All control not found — skipping');
    }
  });

  // ── TC-35: Bulk delete across pagination ────────────────────────────────────
  test('TC-35: Bulk delete respects pagination boundaries', async ({ page }) => {
    console.log('[TC-35] Navigate to My Workspaces');
    await page.locator('a:has-text("My Workspaces")').first().click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 });
    await page.waitForTimeout(1500);

    const nextPageBtn = page.locator('[class*="pagination"] button:has-text("Next"), [class*="pagination"] [aria-label*="next"]').first();
    if (!(await nextPageBtn.isVisible({ timeout: 5000 }).catch(() => false))) {
      console.log('[TC-35] Only one page of workspaces available — pagination-spanning bulk delete not applicable, skipping');
      return;
    }

    const initialCount = await page.locator('.workspace-card, .saved-query-box').count();
    const firstCb = page.locator('.workspace-card, .saved-query-box').first().locator('input[type="checkbox"]').first();
    if (await firstCb.isVisible({ timeout: 3000 }).catch(() => false)) await firstCb.click();

    await nextPageBtn.click();
    await page.waitForTimeout(1500);

    const page2Cb = page.locator('.workspace-card, .saved-query-box').first().locator('input[type="checkbox"]').first();
    if (await page2Cb.isVisible({ timeout: 3000 }).catch(() => false)) await page2Cb.click();

    const bulkDeleteBtn = page.locator('button:has-text("Delete Workspace"), button:has-text("Delete Selected")').first();
    if (await bulkDeleteBtn.isVisible({ timeout: 5000 }).catch(() => false)) {
      await bulkDeleteBtn.click();
      await page.waitForTimeout(500);
      const confirmDialog = page.locator('.swal-overlay:visible').filter({ hasText: /delete/i }).first();
      if (await confirmDialog.isVisible({ timeout: 5000 }).catch(() => false)) {
        await confirmDialog.locator('button.next-btn-swal, button').first().click();
      }
      await page.waitForTimeout(2000);

      const remainingCount = await page.locator('.workspace-card, .saved-query-box').count();
      console.log(`[TC-35] Workspace count before: ${initialCount}, after cross-page bulk delete: ${remainingCount}`);
      console.log('[TC-35] ✅ Bulk delete across pagination completed without errors');
    } else {
      console.log('[TC-35] Bulk delete control not available after cross-page selection — skipping');
    }
  });

