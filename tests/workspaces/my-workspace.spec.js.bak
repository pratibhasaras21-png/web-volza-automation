  // ── TC-40: Case-insensitive workspace search ────────────────────────────────
  test('TC-40: Workspace search is case-insensitive', async ({ page }) => {
    console.log('[TC-40] Navigate to My Workspaces and read an existing workspace name');
    await page.locator('a:has-text("My Workspaces")').first().click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 });
    await page.waitForTimeout(1500);

    const firstCard = page.locator('a.desc-text').first();
    await firstCard.waitFor({ state: 'visible', timeout: 15000 });
    const fullName = await firstCard.getAttribute('title');
    const wsSearchInput = page.locator('input[placeholder*="Search for Descr" i]').first();
    const searchIcon = wsSearchInput.locator('xpath=following-sibling::*[1]');
    const escapedName = fullName.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

    const variants = [fullName.toUpperCase(), fullName.toLowerCase(), fullName];
    for (const variant of variants) {
      await wsSearchInput.fill(variant);
      await searchIcon.click();
      await page.waitForTimeout(1500);
      const matchCount = await page.locator('a.desc-text').filter({ hasText: new RegExp(escapedName, 'i') }).count();
      console.log(`[TC-40] Search "${variant}" -> ${matchCount} match(es)`);
      expect.soft(matchCount).toBeGreaterThan(0);
    }
    console.log(`[TC-40] ✅ "${fullName}" found regardless of case variation`);
  });

  // ── AUTO UPDATE ──────────────────────────────────────────────────────────────

  // ── TC-41: Enable Auto-Update ────────────────────────────────────────────────
  test('TC-41: Enable Auto-Update on a workspace', async ({ page }) => {
    console.log('[TC-41] Navigate to My Workspaces');
    await page.locator('a:has-text("My Workspaces")').first().click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 });
    await page.waitForTimeout(1500);

    const wsCard = page.locator('.workspace-card, .saved-query-box').first();
    await wsCard.waitFor({ state: 'visible', timeout: 15000 });
    const toggle = wsCard.locator('[class*="auto-update"] input[type="checkbox"], [class*="toggle"] input, [class*="toggle"]').first();

    if (await toggle.isVisible({ timeout: 5000 }).catch(() => false)) {
      const wasChecked = await toggle.isChecked().catch(() => false);
      if (!wasChecked) {
        await toggle.click();
        await page.waitForTimeout(2000);
      }
      const nowChecked = await toggle.isChecked().catch(() => true);
      expect.soft(nowChecked).toBeTruthy();
      console.log('[TC-41] ✅ Auto-Update enabled');
    } else {
      console.log('[TC-41] Auto-Update control not found on workspace card — skipping');
    }
  });

  // ── TC-42: Disable Auto-Update ───────────────────────────────────────────────
  test('TC-42: Disable Auto-Update on a workspace', async ({ page }) => {
    console.log('[TC-42] Navigate to My Workspaces');
    await page.locator('a:has-text("My Workspaces")').first().click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 });
