  // ── TC-11: Save workspace with duplicate name ─────────────────────────────
  test('TC-11: Save workspace with duplicate name is handled per business rule', async ({ page }) => {
    console.log('[TC-11] Execute a valid search and save it with a unique name');
    await executeValidSearch(page);
    const workspaceName = `WS_Dup_${Date.now()}`;
    let saveModal = await openSaveWorkspaceModal(page);
    await saveModal.locator('input[placeholder*="Workspace name" i]').first().fill(workspaceName);
    await saveModal.locator('button:has-text("Save Query")').first().click();
    const savedPopup = page.locator('.swal-overlay:visible').filter({ hasText: /saved successfully/i }).first();
    await expect.soft(savedPopup).toBeVisible({ timeout: 10000 });
    await dismissSavedPopup(savedPopup);
    console.log(`[TC-11] ✅ "${workspaceName}" saved (baseline)`);

    console.log('[TC-11] Re-open Save Workspace and enter the same name again');
    saveModal = await openSaveWorkspaceModal(page);
    await saveModal.locator('input[placeholder*="Workspace name" i]').first().fill(workspaceName);
    await saveModal.locator('button:has-text("Save Query")').first().click();
    await page.waitForTimeout(1500);

    const dupError = page.locator('.swal-overlay:visible, [class*="error"]:visible, [role="alert"]:visible')
      .filter({ hasText: /duplicate|already exists|already used|cannot save/i }).first();
    const dupErrorVisible = await dupError.isVisible({ timeout: 8000 }).catch(() => false);
    if (dupErrorVisible) {
      console.log(`[TC-11] ✅ Duplicate-name validation shown: "${(await dupError.textContent())?.trim()}"`);
      const dismissBtn = dupError.locator('button').first();
      if (await dismissBtn.isVisible({ timeout: 2000 }).catch(() => false)) await dismissBtn.click();
    } else {
      console.log('[TC-11] No explicit duplicate error shown — verifying only one workspace with this name exists instead');
    }

    console.log('[TC-11] Navigate to My Workspaces and confirm exactly one workspace carries this name');
    await page.locator('a:has-text("My Workspaces")').first().click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 });
    await page.waitForTimeout(1500);
    const wsSearchInput = page.locator('input[placeholder*="Search for Descr" i]').first();
    await wsSearchInput.fill(workspaceName);
    await wsSearchInput.locator('xpath=following-sibling::*[1]').click();
    await page.waitForTimeout(1500);
    const matches = page.locator('a.desc-text').filter({ hasText: workspaceName });
    const matchCount = await matches.count();
    expect.soft(matchCount, 'Duplicate workspace name should not create a second entry').toBe(1);
    console.log(`[TC-11] ✅ Exactly one workspace named "${workspaceName}" exists`);
  });

  // ── TC-12: Save workspace with blank name ─────────────────────────────────
