const { test, expect } = require('@playwright/test');
const { handleMaxRecordsPopup } = require('../../helpers/maxRecordsPopup');

// ─── Module 7: My Workspace Tab ──────────────────────────────────────────────
// Pre-conditions:
//   • Small/startup plan account
//   • At least one old and one new workspace already created
//   • Multiple user emails available for sharing

test.describe('Module 7 - My Workspace Tab', () => {

  test.beforeEach(async ({ page }) => {
    await page.goto('https://app.volza.com/home');
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 });
  });

  // Helper: click a workspace card's kebab (three-dot) menu and wait for its
  // dropdown to open. The dropdown's open/closed state is toggled by a React
  // click handler that can occasionally miss a single click right after the
  // card grid renders (the click registers but the dropdown stays hidden) -
  // retry the click itself rather than just re-waiting, since re-waiting on
  // the same already-fired click never resolves.
  async function openWorkspaceKebabMenu(wsCard) {
    const threeDots = wsCard.locator('.worspace-menu').first();
    const dropdown = wsCard.locator('.dropdown-content.workspace-item').first();
    for (let attempt = 0; attempt < 5; attempt++) {
      await threeDots.click();
      const opened = await dropdown.waitFor({ state: 'visible', timeout: 2000 }).then(() => true).catch(() => false);
      if (opened) return dropdown;
    }
    throw new Error('[openWorkspaceKebabMenu] Dropdown never opened after 5 click attempts');
  }

  // Helper: run a minimal valid search (Product on "All Country") through to
  // results being visible. Mirrors TC-0's search flow without the
  // save/workspace-list assertions that follow it in that test, so the many
  // TC-11+ tests below don't each repeat the same block.
  async function executeValidSearch(page, product = 'oil') {
    await page.locator('a:has-text("Search"), [href*="search"]').first().click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 });
    await page.waitForTimeout(1000);

    await page.locator('.dropdown-display').first().click();
    await page.waitForTimeout(500);
    await page.locator('[id^="Type_Exports_"]').first().click();
    await page.waitForTimeout(1000);

    const productInput = page.locator('input[placeholder="Add new tag"]').first();
    await productInput.waitFor({ state: 'visible', timeout: 10000 });
    await productInput.click();
    await productInput.fill(product);
    await page.waitForTimeout(1500);
    const suggestion = page.locator('.react-tags__suggestions li').first();
    if (await suggestion.isVisible({ timeout: 3000 }).catch(() => false)) {
      await suggestion.click();
    } else {
      await page.keyboard.press('Enter');
    }
    await page.waitForTimeout(500);

    const searchBtn = page.locator('button.custom-search').first();
    await searchBtn.scrollIntoViewIfNeeded();
    await searchBtn.click();
    await page.waitForURL(/workspace\/search\//, { timeout: 20000 }).catch(() => {});
    await page.waitForLoadState('domcontentloaded', { timeout: 20000 }).catch(() => {});
    await page.waitForLoadState('networkidle', { timeout: 20000 }).catch(() => {});
    await handleMaxRecordsPopup(page);
  }

  // Helper: dismiss the generic blocking "Alert" popup (title bar literally
  // reads "Alert") that the app throws up for business-rule blocks - e.g.
  // "Please delete existing workspaces or upgrade to a higher plan" when at
  // the workspace cap, or "You cannot rename this workspace as it was
  // created by another user". These are dead ends for the action just
  // attempted, so the fix is just to dismiss via the header's close (X)
  // icon and let the caller move on to its next step instead of the test
  // getting stuck here. Matched by the exact "Alert" title rather than any
  // specific message so it catches this whole class of popup, without
  // accidentally swallowing unrelated dialogs like "Share Workspace" or
  // "Delete Workspace?".
  async function dismissAlertPopup(page) {
    const alertPopup = page.locator('[class*="modal"]:visible, [role="dialog"]:visible')
      .filter({ has: page.getByText('Alert', { exact: true }) }).first();
    const shown = await alertPopup.isVisible({ timeout: 3_000 }).catch(() => false);
    if (!shown) return false;
    const message = await alertPopup.locator('p, [class*="message"], [class*="body"]').first().textContent().catch(() => null);
    console.log(`[dismissAlertPopup] ⚠️ "Alert" popup shown${message ? ` ("${message.trim()}")` : ''} - dismissing via the close (X) icon and moving on`);
    const closeIcon = alertPopup.locator('[class*="close" i]:visible, [aria-label="Close" i]:visible').last();
    await closeIcon.click({ timeout: 5_000 }).catch(() => {});
    await alertPopup.waitFor({ state: 'hidden', timeout: 5000 }).catch(() => {});
    return true;
  }

  // Helper: click Save on the Search results toolbar and wait for the "Save
  // Workspace" modal.
  async function openSaveWorkspaceModal(page) {
    const saveBtn = page.locator('li:has-text("Save"), button:has-text("Save")').filter({ hasNotText: /workspace|query/i }).first();
    await saveBtn.click();
    await dismissAlertPopup(page);
    const saveModal = page.locator('[class*="modal"]:visible, [role="dialog"]:visible').filter({ hasText: 'Save Workspace' }).first();
    await expect.soft(saveModal).toBeVisible({ timeout: 8000 });
    return saveModal;
  }

  // Helper: click "saved/updated successfully" popup's OK button, falling
  // back to whatever button it actually renders (see TC-0's comment on why).
  async function dismissSavedPopup(popup) {
    let okBtn = popup.locator('button.next-btn-swal').first();
    if (!(await okBtn.isVisible({ timeout: 3_000 }).catch(() => false))) {
      okBtn = popup.locator('button').first();
    }
    await okBtn.click();
    await popup.waitFor({ state: 'hidden', timeout: 5000 }).catch(() => {});
  }

  // Helper: open the Share Workspace modal for a given workspace card,
  // retrying the kebab-open + Share-click sequence (same flakiness
  // openWorkspaceKebabMenu already retries for internally).
  async function openShareWorkspaceModal(page, wsCard) {
    const shareModal = page.locator('.ReactModal__Content:visible').filter({ hasText: 'Share Workspace' }).first();
    for (let attempt = 0; attempt < 3; attempt++) {
      const dropdown = await openWorkspaceKebabMenu(wsCard);
      const shareOption = dropdown.locator('.df-panel-tools').filter({ hasText: /share/i }).first();
      if (await shareOption.isVisible({ timeout: 3_000 }).catch(() => false)) {
        await shareOption.click({ timeout: 5_000 }).catch(() => {});
        if (await shareModal.isVisible({ timeout: 3_000 }).catch(() => false)) return shareModal;
      }
    }
    await expect.soft(shareModal).toBeVisible({ timeout: 8000 });
    return shareModal;
  }

  // ── TC-0: Search "oil" (All Country) then save and verify the workspace ───
  // End-to-end flow: Search tab -> All Country (Global Search) -> Product
  // "oil" -> Search -> results -> Save -> unique workspace name -> "saved
  // successfully" popup -> OK -> My Workspaces tab -> new workspace is listed.
  test('TC-0: Search by product "oil" across All Country, save workspace, and verify it in My Workspaces', async ({ page }) => {
    console.log('[TC-0] Navigate to Search tab');
    await page.locator('a:has-text("Search"), [href*="search"]').first().click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 });
    await page.waitForTimeout(1000);

    console.log('[TC-0] Select "All Country (Global Search)"');
    await page.locator('.dropdown-display').first().click();
    await page.waitForTimeout(500);
    await page.locator('[id^="Type_Exports_"]').first().click();
    await page.waitForTimeout(1000);
    console.log('[TC-0] ✅ "All Country (Global Search)" selected');

    console.log('[TC-0] Enter Product "oil" (Search Field already defaults to Product)');
    const productInput = page.locator('input[placeholder="Add new tag"]').first();
    await productInput.waitFor({ state: 'visible', timeout: 10000 });
    await productInput.click();
    await productInput.fill('oil');
    await page.waitForTimeout(1500);
    const suggestion = page.locator('.react-tags__suggestions li').first();
    if (await suggestion.isVisible({ timeout: 3000 }).catch(() => false)) {
      await suggestion.click();
    } else {
      await page.keyboard.press('Enter');
    }
    await page.waitForTimeout(500);
    console.log('[TC-0] ✅ "oil" tokenized on search box');

    console.log('[TC-0] Click Search and wait for results');
    const searchBtn = page.locator('button.custom-search').first();
    await searchBtn.scrollIntoViewIfNeeded();
    await searchBtn.click();
    await page.waitForURL(/workspace\/search\//, { timeout: 20000 }).catch(() => {});
    await page.waitForLoadState('domcontentloaded', { timeout: 20000 }).catch(() => {});
    await page.waitForLoadState('networkidle', { timeout: 20000 }).catch(() => {});
    await handleMaxRecordsPopup(page);

    const gridRows = page.locator('tbody tr:not(.ant-table-measure-row):has(td)');
    await expect.soft(gridRows.first()).toBeVisible({ timeout: 30000 });
    console.log('[TC-0] ✅ Search results displayed');

    console.log('[TC-0] Click Save - "Save Workspace" modal opens');
    const saveBtn = page.locator('li:has-text("Save"), button:has-text("Save")').filter({ hasNotText: /workspace|query/i }).first();
    await saveBtn.click();
    await dismissAlertPopup(page);
    const saveModal = page.locator('[class*="modal"]:visible, [role="dialog"]:visible').filter({ hasText: 'Save Workspace' }).first();
    await expect.soft(saveModal).toBeVisible({ timeout: 8000 });
    console.log('[TC-0] ✅ "Save Workspace" popup opened');

    // Unique per run - reusing the same literal name across repeat runs
    // triggers a "Cannot save duplicate name" alert instead of success.
    const workspaceName = `MyWorkspace_Oil_${Date.now()}`;
    const wsNameInput = saveModal.locator('input[placeholder*="Workspace name" i]').first();
    await wsNameInput.fill(workspaceName);
    console.log(`[TC-0] Workspace name entered: "${workspaceName}"`);

    const saveQueryBtn = saveModal.locator('button:has-text("Save Query")').first();
    await saveQueryBtn.click();

    console.log('[TC-0] Wait for "saved successfully" popup and click OK');
    const savedPopup = page.locator('.swal-overlay:visible').filter({ hasText: /saved successfully/i }).first();
    await expect.soft(savedPopup).toBeVisible({ timeout: 10000 });
    // This popup doesn't consistently use the "next-btn-swal" class the delete-confirmation
    // swal (TC-5) does - fall back to whatever button it actually renders.
    let savedPopupOkBtn = savedPopup.locator('button.next-btn-swal').first();
    if (!(await savedPopupOkBtn.isVisible({ timeout: 3_000 }).catch(() => false))) {
      savedPopupOkBtn = savedPopup.locator('button').first();
    }
    await savedPopupOkBtn.click();
    await savedPopup.waitFor({ state: 'hidden', timeout: 5000 }).catch(() => {});
    console.log(`[TC-0] ✅ Workspace "${workspaceName}" saved successfully`);

    console.log('[TC-0] Navigate to My Workspaces and verify the new workspace is listed');
    await page.locator('a:has-text("My Workspaces")').first().click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 });
    await page.waitForTimeout(1500);

    const newWorkspaceCard = page.locator(`a[title="${workspaceName}"]`).first();
    await expect.soft(newWorkspaceCard).toBeVisible({ timeout: 15000 });
    console.log(`[TC-0] ✅ "${workspaceName}" found in My Workspaces`);

    console.log('[TC-0] Search for the workspace by name in the My Workspaces search bar');
    const wsSearchInput = page.locator('input[placeholder*="Search for Descr" i]').first();
    await wsSearchInput.fill(workspaceName);
    // The list only filters once the search icon (or Enter) actually triggers
    // the search - typing alone doesn't auto-filter.
    await wsSearchInput.locator('xpath=following-sibling::*[1]').click();
    await page.waitForTimeout(1500);

    const searchResultCards = page.locator('a.desc-text');
    await expect.soft(searchResultCards).toHaveCount(1, { timeout: 10000 });
    await expect.soft(searchResultCards.first()).toHaveAttribute('title', workspaceName);
    console.log(`[TC-0] ✅ Searching "${workspaceName}" shows exactly that workspace in the results`);

    console.log('[TC-0] Clear the search and open a random workspace from the list');
    await wsSearchInput.fill('');
    await wsSearchInput.locator('xpath=following-sibling::*[1]').click();
    await page.waitForTimeout(1500);

    const allCards = page.locator('a.desc-text');
    const cardCount = await allCards.count();
    expect.soft(cardCount).toBeGreaterThan(0);
    const randomIndex = Math.floor(Math.random() * cardCount);
    const randomCard = allCards.nth(randomIndex);
    const randomWsName = await randomCard.getAttribute('title');
    console.log(`[TC-0] Opening random workspace (${randomIndex + 1}/${cardCount}): "${randomWsName}"`);

    await randomCard.click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 }).catch(() => {});
    await page.waitForLoadState('networkidle', { timeout: 20000 }).catch(() => {});
    await page.waitForTimeout(1500);

    await expect.soft(page).toHaveURL(/workspace\/search\//, { timeout: 15000 });
    console.log(`[TC-0] ✅ "${randomWsName}" opened on the Search tab (URL: ${page.url()})`);

    // A randomly picked workspace may legitimately have zero shipments, so
    // treat the results grid as a soft check rather than failing the test.
    const openedGridRows = page.locator('tbody tr:not(.ant-table-measure-row):has(td)');
    const hasResults = await openedGridRows.first().isVisible({ timeout: 15000 }).catch(() => false);
    console.log(hasResults
      ? `[TC-0] ✅ "${randomWsName}" shows results in the Search tab grid`
      : `[TC-0] ⚠️ "${randomWsName}" opened but has no visible grid rows (may be a genuinely empty workspace)`);
  });

  // ── TC-1: My Workspace tab loads ──────────────────────────────────────────
  test('TC-1: My Workspace tab loads successfully', async ({ page }) => {
    console.log('[TC-1] Click My Workspaces tab');
    await page.locator('a:has-text("My Workspaces")').first().click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 });

    const workspaceList = page.locator('.workspace-card, .saved-query-box').first();
    await expect.soft(workspaceList).toBeVisible({ timeout: 15000 });
    console.log('[TC-1] ✅ My Workspace tab loaded');
  });

  // ── TC-2: Open old and new workspaces ─────────────────────────────────────
  test('TC-2: Open new and old workspaces with their databases', async ({ page }) => {
    console.log('[TC-2] Navigate to My Workspaces');
    await page.locator('a:has-text("My Workspaces")').first().click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 });

    const firstWorkspace = page.locator('a.desc-text').first();
    await firstWorkspace.waitFor({ state: 'visible', timeout: 15000 });
    const wsName = await firstWorkspace.getAttribute('title');
    await firstWorkspace.click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 }).catch(() => {});
    await page.waitForLoadState('networkidle', { timeout: 20000 }).catch(() => {});
    await page.waitForTimeout(1500);

    await expect.soft(page).toHaveURL(/workspace\/search\//, { timeout: 15000 });
    // A workspace may legitimately have zero shipments for its saved query,
    // so treat the grid as a soft check rather than a hard requirement.
    const searchGrid = page.locator('tbody tr:not(.ant-table-measure-row):has(td)').first();
    const hasResults = await searchGrid.isVisible({ timeout: 15000 }).catch(() => false);
    console.log(hasResults
      ? `[TC-2] ✅ "${wsName}" opened with database results`
      : `[TC-2] ⚠️ "${wsName}" opened but shows no results (may be a genuinely empty workspace)`);
  });

  // ── TC-3: Auto-update toggle functionality ────────────────────────────────
  test('TC-3: Auto-update toggle updates workspace to latest available data', async ({ page }) => {
    console.log('[TC-3] Navigate to My Workspace');
    await page.locator('a:has-text("My Workspace"), [href*="workspace"]').first().click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 });

    const autoUpdateToggle = page.locator('[class*="auto-update"] input[type="checkbox"], [class*="toggle"]')
      .filter({ hasText: /auto.*update|auto update/i }).first();
    if (await autoUpdateToggle.isVisible()) {
      await autoUpdateToggle.click();
      await page.waitForTimeout(2000);
      console.log('[TC-3] ✅ Auto-update toggle clicked');
    } else {
      const toggleEl = page.locator('[class*="workspace-item"], tbody tr').first()
        .locator('input[type="checkbox"], [class*="toggle"]').first();
      if (await toggleEl.isVisible()) {
        await toggleEl.click();
        await page.waitForTimeout(2000);
        console.log('[TC-3] ✅ Auto-update toggle on workspace row clicked');
      }
    }
  });

  // ── TC-4: Open workspace by clicking its name ─────────────────────────────
  test('TC-4: Click on workspace name to open it', async ({ page }) => {
    console.log('[TC-4] Navigate to My Workspaces and click first workspace name');
    await page.locator('a:has-text("My Workspaces")').first().click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 });

    const wsNameLink = page.locator('a.desc-text').first();
    await wsNameLink.waitFor({ state: 'visible', timeout: 15000 });
    const wsName = await wsNameLink.getAttribute('title');
    await wsNameLink.click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 }).catch(() => {});
    await page.waitForLoadState('networkidle', { timeout: 20000 }).catch(() => {});
    await page.waitForTimeout(1500);

    await expect.soft(page).toHaveURL(/workspace\/search\//, { timeout: 15000 });
    console.log(`[TC-4] ✅ "${wsName}" opened successfully on the Search tab`);
  });

  // ── TC-5: Delete workspace via three-dot menu ─────────────────────────────
  test('TC-5: Delete workspace via three-dot (kebab) menu', async ({ page }) => {
    console.log('[TC-5] Navigate to My Workspaces');
    await page.locator('a:has-text("My Workspaces")').first().click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 });

    // Newest workspaces sort first, so this targets the most recently
    // created one (e.g. one of this suite's own test workspaces) rather
    // than an older, possibly important one.
    const wsCard = page.locator('.workspace-card, .saved-query-box').first();
    await wsCard.waitFor({ state: 'visible', timeout: 15000 });
    const wsName = await wsCard.locator('a.desc-text').first().getAttribute('title');
    console.log(`[TC-5] Deleting workspace: "${wsName}"`);

    const dropdown = await openWorkspaceKebabMenu(wsCard);
    const deleteOption = dropdown.locator('.df-panel-tools').filter({ hasText: /delete/i }).first();
    await deleteOption.waitFor({ state: 'visible', timeout: 5000 });
    await deleteOption.click();
    await page.waitForTimeout(800);

    const confirmDialog = page.locator('.swal-overlay:visible').filter({ hasText: /delete workspace/i }).first();
    await expect.soft(confirmDialog).toBeVisible({ timeout: 8000 });
    await confirmDialog.locator('button.next-btn-swal').click();
    await confirmDialog.waitFor({ state: 'hidden', timeout: 5000 }).catch(() => {});
    await page.waitForTimeout(1500);

    const deletedCard = page.locator(`a[title="${wsName}"]`).first();
    await expect.soft(deletedCard).toBeHidden({ timeout: 10000 });
    console.log(`[TC-5] ✅ "${wsName}" deleted and no longer listed`);
  });

  // ── TC-6: Share workspace via three-dot menu ──────────────────────────────
  test('TC-6: Share workspace with another user', async ({ page }) => {
    console.log('[TC-6] Navigate to My Workspaces');
    await page.locator('a:has-text("My Workspaces")').first().click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 });

    const wsCard = page.locator('.workspace-card, .saved-query-box').first();
    await wsCard.waitFor({ state: 'visible', timeout: 15000 });

    // The dropdown can close on its own shortly after opening (the same underlying flakiness
    // openWorkspaceKebabMenu already retries for) before its "Share" item is clicked - retry
    // the whole open-menu-then-click sequence rather than just the initial dropdown open.
    const shareModal = page.locator('.ReactModal__Content:visible').filter({ hasText: 'Share Workspace' }).first();
    let shareModalOpened = false;
    for (let attempt = 0; attempt < 3 && !shareModalOpened; attempt++) {
      const dropdown = await openWorkspaceKebabMenu(wsCard);
      const shareOption = dropdown.locator('.df-panel-tools').filter({ hasText: /share/i }).first();
      const optionVisible = await shareOption.isVisible({ timeout: 3_000 }).catch(() => false);
      if (optionVisible) {
        await shareOption.click({ timeout: 5_000 }).catch(() => {});
        shareModalOpened = await shareModal.isVisible({ timeout: 3_000 }).catch(() => false);
      }
    }
    await expect.soft(shareModal).toBeVisible({ timeout: 8000 });
    console.log('[TC-6] ✅ "Share Workspace" modal opened, listing existing users with View / View & Edit access');

    // The modal lists existing account users with access checkboxes (not a
    // free-text email field).
    const userRows = shareModal.locator('.rt-tr-group');
    const userCount = await userRows.count();
    expect.soft(userCount).toBeGreaterThan(0);
    console.log(`[TC-6] ✅ ${userCount} user(s) listed to share with`);

    console.log('[TC-6] Select a checkbox (View or View & Edit) for one user and click Share');
    const shareCheckboxes = shareModal.locator('input[type="checkbox"]');
    const checkboxCount = await shareCheckboxes.count();
    expect.soft(checkboxCount).toBeGreaterThan(0);
    if (checkboxCount > 0) {
      const targetCheckbox = shareCheckboxes.first();
      if (!(await targetCheckbox.isChecked().catch(() => false))) {
        await targetCheckbox.check({ timeout: 5000 }).catch(() => targetCheckbox.click());
      }
      console.log('[TC-6] ✅ Checkbox selected for one user');

      const shareActionBtn = shareModal.locator('button:has-text("Share")').first();
      await shareActionBtn.click({ timeout: 5000 }).catch(() => {});
      await page.waitForTimeout(1000);
      console.log('[TC-6] ✅ Clicked "Share" to grant the selected access');

      console.log('[TC-6] Confirm the share action in the "Share Workspace?" prompt');
      const shareConfirmDialog = page.locator('[class*="modal"]:visible, [role="dialog"]:visible, .swal-overlay:visible')
        .filter({ hasText: /are you sure you want to update the selected users/i }).first();
      if (await shareConfirmDialog.isVisible({ timeout: 5000 }).catch(() => false)) {
        await shareConfirmDialog.locator('button:has-text("Save")').first().click();
        await shareConfirmDialog.waitFor({ state: 'hidden', timeout: 5000 }).catch(() => {});
        console.log('[TC-6] ✅ Confirmed share via "Save"');
      }

      console.log('[TC-6] Wait for "shared successfully" popup and click OK');
      const sharedSuccessPopup = page.locator('.swal-overlay:visible, [class*="modal"]:visible, [role="dialog"]:visible')
        .filter({ hasText: /shared successfully/i }).first();
      if (await sharedSuccessPopup.isVisible({ timeout: 8000 }).catch(() => false)) {
        await dismissSavedPopup(sharedSuccessPopup);
        console.log('[TC-6] ✅ "Workspace shared successfully" popup dismissed');
      }
    }

    // Some flows auto-close the modal after Share succeeds - only fall back
    // to Close if it's still open.
    if (await shareModal.isVisible({ timeout: 2000 }).catch(() => false)) {
      await shareModal.locator('button:has-text("Close")').first().click();
      await shareModal.waitFor({ state: 'hidden', timeout: 5000 }).catch(() => {});
    }
  });

  // ── TC-7: Multi-select and bulk delete workspaces ─────────────────────────
  test('TC-7: Select multiple workspaces and bulk delete', async ({ page }) => {
    console.log('[TC-7] Navigate to My Workspace');
    await page.locator('a:has-text("My Workspace"), [href*="workspace"]').first().click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 });

    const wsCheckboxes = page.locator('[class*="workspace-item"] input[type="checkbox"], tbody tr input[type="checkbox"]');
    const count = await wsCheckboxes.count();
    if (count >= 2) {
      await wsCheckboxes.nth(0).click();
      await wsCheckboxes.nth(1).click();
      console.log('[TC-7] Two workspaces selected');

      const bulkDeleteBtn = page.locator('button:has-text("Delete Workspace"), button:has-text("Delete Selected")').first();
      await bulkDeleteBtn.waitFor({ state: 'visible', timeout: 8000 });
      await bulkDeleteBtn.click();
      await page.waitForTimeout(500);
      const confirmBtn = page.locator('button:has-text("Delete"), button:has-text("Yes"), button:has-text("Confirm")').first();
      if (await confirmBtn.isVisible()) await confirmBtn.click();
      await page.waitForTimeout(2000);
      console.log('[TC-7] ✅ Multiple workspaces deleted');
    } else {
      console.log('[TC-7] Less than 2 workspaces available for bulk delete test');
    }
  });

  // ── TC-8: Filter workspaces by database type and country ──────────────────
  test('TC-8: Filter workspaces by database dropdown and country', async ({ page }) => {
    console.log('[TC-8] Navigate to My Workspace');
    await page.locator('a:has-text("My Workspace"), [href*="workspace"]').first().click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 });

    const dbDropdown = page.locator('select, [class*="database-filter"], [class*="filter-dropdown"]').first();
    if (await dbDropdown.isVisible()) {
      await dbDropdown.selectOption({ index: 1 }).catch(async () => {
        await dbDropdown.click();
        await page.locator('li, option').nth(1).click();
      });
      await page.waitForTimeout(1500);
      console.log('[TC-8] ✅ Database filter applied');

      const filteredList = page.locator('[class*="workspace-item"], tbody tr');
      const filteredCount = await filteredList.count();
      console.log(`[TC-8] Workspaces after filter: ${filteredCount}`);
    }
  });

