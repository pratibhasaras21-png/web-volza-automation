      await page.waitForLoadState('networkidle', { timeout: 20000 }).catch(() => {});
      await handleMaxRecordsPopup(page);
      console.log('[TC-18] Added "cotton" and re-ran search');

      console.log('[TC-18] Save/update the workspace (keeping the same name)');
      const saveModal = await openSaveWorkspaceModal(page);
      const updateBtn = saveModal.locator('button:has-text("Update"), button:has-text("Save Query")').first();
      await updateBtn.click();
