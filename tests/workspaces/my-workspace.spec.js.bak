      if (await savedPopup.isVisible({ timeout: 8000 }).catch(() => false)) {
        await dismissSavedPopup(savedPopup);
      }

      console.log('[TC-18] Close and reopen the workspace to verify persistence');
      await page.locator('a:has-text("My Workspaces")').first().click();
      await page.waitForLoadState('domcontentloaded', { timeout: 15000 });
      await page.waitForTimeout(1500);
      const reopenLink = page.locator('a.desc-text').filter({ hasText: wsName }).first();
      await reopenLink.click();
      await page.waitForLoadState('domcontentloaded', { timeout: 15000 }).catch(() => {});
      await page.waitForLoadState('networkidle', { timeout: 20000 }).catch(() => {});
      await page.waitForTimeout(1500);

      const cottonTag = page.locator('.react-tags__selected, [class*="react-tags"]').filter({ hasText: /cotton/i }).first();
      const persisted = await cottonTag.isVisible({ timeout: 8000 }).catch(() => false);
      console.log(persisted
        ? '[TC-18] ✅ Updated configuration ("cotton") persisted after reopening'
        : '[TC-18] ⚠️ Could not directly confirm the updated criterion persisted');
    } else {
      console.log('[TC-18] Product filter input not available on this workspace — skipping edit');
    }
  });

