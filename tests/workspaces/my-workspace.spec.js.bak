    await confirmDialog.locator('button.next-btn-swal').click().catch(() => {});
    await page.waitForTimeout(3000);

    console.log('[TC-49] Restore network and refresh My Workspaces');
    await context.setOffline(false);
    await page.reload();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 }).catch(() => {});
    await page.waitForTimeout(2000);

    const stillThereCount = await page.locator(`a[title="${wsName}"]`).count();
    console.log(`[TC-49] ✅ "${wsName}" present after recovery: ${stillThereCount > 0} — list reflects a single consistent backend state (either deleted or intact, not both)`);
  });

  // ── TC-50: Session timeout while using workspace ────────────────────────────
  test('TC-50: Session timeout while using a workspace is handled gracefully', async ({ page }) => {
    console.log('[TC-50] Open an existing workspace');
