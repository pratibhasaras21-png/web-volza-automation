  // ── TC-14: Save workspace with maximum supported name length ──────────────
  test('TC-14: Save workspace with maximum supported name length', async ({ page }) => {
    console.log('[TC-14] Execute a valid search');
    await executeValidSearch(page);

    const saveModal = await openSaveWorkspaceModal(page);
    const wsNameInput = saveModal.locator('input[placeholder*="Workspace name" i]').first();
    const maxLengthAttr = await wsNameInput.getAttribute('maxlength');
    const limit = maxLengthAttr ? Number(maxLengthAttr) : 100;
    const suffix = `_${Date.now()}`;
    const workspaceName = ('A'.repeat(Math.max(limit - suffix.length, 1)) + suffix).slice(0, limit);
    console.log(`[TC-14] Field maxlength attribute: ${maxLengthAttr ?? `not set, assuming ${limit}`}; using a ${workspaceName.length}-char name`);

    await wsNameInput.fill(workspaceName);
    await saveModal.locator('button:has-text("Save Query")').first().click();
    await page.waitForTimeout(1500);

    const savedPopup = page.locator('.swal-overlay:visible').filter({ hasText: /saved successfully/i }).first();
    await expect.soft(savedPopup, 'Workspace at max supported name length should save successfully').toBeVisible({ timeout: 10000 });
    await dismissSavedPopup(savedPopup);
    console.log(`[TC-14] ✅ Workspace saved with a ${workspaceName.length}-character name`);
  });

  // ── TC-15: Workspace name exceeding maximum length ─────────────────────────
  test('TC-15: Workspace name exceeding maximum length is prevented or rejected', async ({ page }) => {
    console.log('[TC-15] Execute a valid search');
    await executeValidSearch(page);

    const saveModal = await openSaveWorkspaceModal(page);
    const wsNameInput = saveModal.locator('input[placeholder*="Workspace name" i]').first();
    const maxLengthAttr = await wsNameInput.getAttribute('maxlength');

    const oversizedName = `Oversized_${'X'.repeat(300)}_${Date.now()}`;
    await wsNameInput.fill(oversizedName);
    const acceptedValue = await wsNameInput.inputValue();

    if (maxLengthAttr && acceptedValue.length <= Number(maxLengthAttr)) {
      console.log(`[TC-15] ✅ Input truncated by maxlength="${maxLengthAttr}" — invalid length prevented at the field level (accepted ${acceptedValue.length} chars)`);
      await page.keyboard.press('Escape').catch(() => {});
      return;
    }

    console.log(`[TC-15] No maxlength truncation observed (accepted ${acceptedValue.length} chars) — attempting Save Query`);
    await saveModal.locator('button:has-text("Save Query")').first().click();
    await page.waitForTimeout(1500);

    const validationError = page.locator('.swal-overlay:visible, [class*="error"]:visible, [role="alert"]:visible')
      .filter({ hasText: /length|long|limit|invalid|characters/i }).first();
    const errorShown = await validationError.isVisible({ timeout: 5000 }).catch(() => false);
    const savedPopup = page.locator('.swal-overlay:visible').filter({ hasText: /saved successfully/i }).first();
    const saved = await savedPopup.isVisible({ timeout: 5000 }).catch(() => false);

    expect.soft(errorShown || !saved, 'An oversized name should either show a validation message or fail to save').toBeTruthy();
    console.log(`[TC-15] ✅ Oversized name handled (validation shown: ${errorShown}, saved: ${saved})`);

    if (saved) await dismissSavedPopup(savedPopup);
    await page.keyboard.press('Escape').catch(() => {});
  });

