  // ── PERFORMANCE / ERROR HANDLING ────────────────────────────────────────────

  // ── TC-46: Workspace loading performance ────────────────────────────────────
  test('TC-46: My Workspaces and individual workspace loading performance', async ({ page }) => {
    console.log('[TC-46] Measure My Workspaces page load time');
    const listStart = Date.now();
    await page.locator('a:has-text("My Workspaces")').first().click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 });
    const workspaceList = page.locator('.workspace-card, .saved-query-box').first();
    await workspaceList.waitFor({ state: 'visible', timeout: 20000 });
    const listLoadMs = Date.now() - listStart;
    console.log(`[TC-46] My Workspaces list loaded in ${listLoadMs}ms`);

    const wsLink = page.locator('a.desc-text').first();
    const wsName = await wsLink.getAttribute('title');
    const openStart = Date.now();
    await wsLink.click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 }).catch(() => {});
    await page.waitForLoadState('networkidle', { timeout: 20000 }).catch(() => {});
    await page.waitForTimeout(500);
    const openLoadMs = Date.now() - openStart;
    console.log(`[TC-46] "${wsName}" opened in ${openLoadMs}ms`);

    const perfSlaMs = Number(process.env.WORKSPACE_LOAD_SLA_MS) || 15000;
    expect.soft(listLoadMs, `My Workspaces list should load within ${perfSlaMs}ms SLA`).toBeLessThan(perfSlaMs);
    expect.soft(openLoadMs, `Workspace open should complete within ${perfSlaMs}ms SLA`).toBeLessThan(perfSlaMs);
    console.log(`[TC-46] ✅ Both loads completed within the ${perfSlaMs}ms SLA`);
  });

  // ── TC-47: Workspace API/server error handling ──────────────────────────────
  test('TC-47: Workspace API failure is handled without crashing', async ({ page }) => {
    console.log('[TC-47] Intercept the workspace list API and force a 500 error');
    const workspaceApiPattern = /\/api\/.*workspace.*/i;
    await page.route(workspaceApiPattern, (route) => {
      route.fulfill({ status: 500, contentType: 'application/json', body: JSON.stringify({ error: 'Simulated server error' }) });
    });

    const pageErrors = [];
    page.on('pageerror', (err) => pageErrors.push(err.message));

    await page.locator('a:has-text("My Workspaces")').first().click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 }).catch(() => {});
    await page.waitForTimeout(3000);

    const errorState = page.locator('[class*="error"], [class*="failed"], [role="alert"]')
      .filter({ hasText: /error|failed|something went wrong|try again/i }).first();
    const errorShown = await errorState.isVisible({ timeout: 8000 }).catch(() => false);
    const crashed = await page.locator('body').isHidden().catch(() => false);

    console.log(`[TC-47] Error state shown: ${errorShown}, page crashed: ${crashed}, unhandled JS errors: ${pageErrors.length}`);
    expect.soft(crashed).toBeFalsy();
    expect.soft(pageErrors, `No unhandled JS errors expected on API failure: ${pageErrors.join('; ')}`).toHaveLength(0);
    console.log('[TC-47] ✅ Application did not crash on simulated workspace API failure');

    await page.unroute(workspaceApiPattern);
  });

  // ── TC-48: Network interruption while saving workspace ──────────────────────
  test('TC-48: Network interruption while saving a workspace does not corrupt state', async ({ page, context }) => {
    console.log('[TC-48] Execute a valid search');
    await executeValidSearch(page);

    const workspaceName = `WS_NetFail_${Date.now()}`;
    const saveModal = await openSaveWorkspaceModal(page);
    await saveModal.locator('input[placeholder*="Workspace name" i]').first().fill(workspaceName);

    console.log('[TC-48] Simulate a network interruption right as Save Query is clicked');
    await context.setOffline(true);
    const saveQueryBtn = saveModal.locator('button:has-text("Save Query")').first();
    await saveQueryBtn.click().catch(() => {});
    await page.waitForTimeout(3000);

    console.log('[TC-48] Restore network');
    await context.setOffline(false);
    await page.waitForTimeout(1500);

    const errorState = page.locator('[class*="error"], [role="alert"], .swal-overlay:visible')
      .filter({ hasText: /error|failed|try again|network/i }).first();
    const errorShown = await errorState.isVisible({ timeout: 8000 }).catch(() => false);
    console.log(`[TC-48] Error/retry state shown during interruption: ${errorShown}`);

    await page.keyboard.press('Escape').catch(() => {});
    await page.locator('a:has-text("My Workspaces")').first().click();
    await page.waitForLoadState('domcontentloaded', { timeout: 15000 }).catch(() => {});
    await page.waitForTimeout(1500);

    const matchCount = await page.locator('a.desc-text').filter({ hasText: workspaceName }).count();
    expect.soft(matchCount, 'A workspace interrupted mid-save should not create duplicate/corrupted entries').toBeLessThanOrEqual(1);
    console.log(`[TC-48] ✅ ${matchCount} workspace(s) named "${workspaceName}" found after network recovery (no duplicates)`);
  });

  // ── TC-49: Network interruption while deleting workspace ────────────────────
  test('TC-49: Network interruption while deleting a workspace leaves a consistent list', async ({ page, context }) => {
    console.log('[TC-49] Navigate to My Workspaces and select a workspace to delete');
    await page.locator('a:has-text("My Workspaces")').first().click();
