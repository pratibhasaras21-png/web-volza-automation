    const wsSearchInput = page.locator('input[placeholder*="Search for Descr" i]').first();
    await wsSearchInput.fill(partial);
    await wsSearchInput.locator('xpath=following-sibling::*[1]').click();
    await page.waitForTimeout(1500);

    const resultCount = await page.locator('a.desc-text').count();
    expect.soft(resultCount).toBeGreaterThan(0);
    console.log(`[TC-38] ✅ ${resultCount} workspace(s) matched partial name "${partial}"`);
  });

